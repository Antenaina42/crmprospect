generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  COMMERCIAL
}

model User {
  id                String        @id @default(cuid())
  name              String
  email             String        @unique
  passwordHash      String
  role              Role          @default(COMMERCIAL)
  avatar            String?
  active            Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  assignedProspects Prospect[]    @relation("AssignedCommercial")
  createdProspects  Prospect[]    @relation("CreatedBy")
  callLogs          CallLog[]
  appointments      Appointment[]
  quotes            Quote[]
  auditLogs         AuditLog[]
}

model City {
  id         String   @id @default(cuid())
  name       String   @unique
  region     String
  postalCode String?
  createdAt  DateTime @default(now())
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
}

model Prospect {
  id               String   @id @default(cuid())
  googlePlaceId    String?  @unique
  name             String
  category         String
  phone            String
  phoneSecondary   String?
  email            String?
  address          String
  city             String
  region           String   @default("Analamanga")
  website          String?
  decisionMaker    String?
  facebook         String?
  linkedin         String?
  notes            String?
  status           String   @default("Nouveau")
  priority         String   @default("Moyenne")
  isClient         Boolean  @default(false)
  convertedAt      DateTime?
  rating           Float?
  userRatingsTotal Int?
  lat              Float?
  lng              Float?
  importedAt       DateTime @default(now())
  updatedAt        DateTime @updatedAt

  assignedToId     String?
  assignedTo       User?    @relation("AssignedCommercial", fields: [assignedToId], references: [id])
  createdById      String?
  createdBy        User?    @relation("CreatedBy", fields: [createdById], references: [id])

  callLogs         CallLog[]
  appointments     Appointment[]
  quotes           Quote[]
}

model CallLog {
  id         String   @id @default(cuid())
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])

  callDate   DateTime @default(now())
  duration   Int      @default(0)
  result     String
  notes      String?
  createdAt  DateTime @default(now())
}

model Appointment {
  id              String   @id @default(cuid())
  prospectId      String
  prospect        Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id])

  title           String
  description     String?
  startTime       DateTime
  endTime         DateTime
  status          String   @default("Planifié")
  type            String   @default("Rendez-vous")
  reminderMinutes Int      @default(15)
  createdAt       DateTime @default(now())
}

model Quote {
  id          String   @id @default(cuid())
  quoteNumber String   @unique
  prospectId  String
  prospect    Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])

  totalAmount Float
  status      String   @default("Brouillon")
  validUntil  DateTime
  itemsJson   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   String?
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
